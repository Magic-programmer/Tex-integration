    },
    {
      "name": "Сделки",
      "filename": "Сделки.csv",
      "path": "crm/lead/list",
      "params": {"order_by[asc][]": "id", "customfields": 1},
      "allow_empty": false,
      "columns": [
        {"header": "Название", "field": "name", "transform": "text", "strip": true, "normalize_nbsp": true},
        {"header": "Создана", "field": "created_date", "transform": "datetime"},
        {"header": "Бюджет", "field": "budget", "transform": "money"},
        {"header": "Этап сделки", "field": "pipeline_stage_id", "transform": "lookup", "lookup": "stages", "closed_labels": {"2": "Проиграна", "3": "Успешно закрыта", "4": "Приостановлена"}, "strip": true},
        {"header": "Компания", "field": "company_id", "transform": "lookup", "lookup": "companies", "empty_if_missing": true, "blank_if_unpaired_quotes": true, "normalize_nbsp": true, "escape_apostrophe": true},
        {"header": "Ответственный", "field": "assignee_id", "transform": "lookup", "lookup": "users"},
        {"header": "Источник сделки", "field": "source_id", "transform": "lookup", "lookup": "sources"},
        {"header": "Дата закрытия", "field": "closing_date", "transform": "date"},
        {"header": "Воронка продаж", "field": "pipeline_id", "transform": "lookup", "lookup": "pipelines"},
        {"header": "Статус", "field": "active", "transform": "enum", "values": {"1": "Активна", "2": "Проиграна", "3": "Успешно закрыта", "4": "Приостановлена"}},
        {"header": "Причина отказа", "field": "closing_status_id", "transform": "lookup", "lookup": "loss_reasons", "only_active": "2"},
        {"header": "Встречались", "field": "customfields", "transform": "custom", "custom_id": 4, "value_transform": "enum", "values": {"0": "Нет", "1": "Да"}, "empty_value": "Нет"},
        {"header": "Город", "field": "customfields", "transform": "custom", "custom_id": 6, "strip": true},
        {"header": "Агент", "field": "customfields", "transform": "custom", "custom_id": 1, "value_transform": "lookup", "lookup": "accounts"},
        {"header": "Дата начала", "field": "start_date", "transform": "date"},
        {"header": "Дата последней активности", "field": "last_activity_time", "transform": "datetime"},
        {"header": "ID", "field": "id", "transform": "text"},
        {"header": "Дела", "transform": "constant", "value": "", "evidence": "All 18532 supplied manual export rows are blank; validated presentation only, not an API activity count."}
      ]
    },
    {
      "name": "Задачи",
      "filename": "Задачи.csv",
      "path": "task/tasks/list",
      "params": {"order_by[asc][]": "id", "filter[type]": "0", "filter[archive_status]": "0"},
      "allow_empty": false,
      "row_filters": {"archive_status": "0"},
      "columns": [
        {"header": "ID", "field": "id", "transform": "task_id"},
        {"header": "Название", "field": "name", "transform": "text", "strip": true, "blank_if_unpaired_quotes": true, "normalize_nbsp": true, "escape_apostrophe": true},
        {"header": "Статус", "field": "status", "transform": "enum", "values": {"1": "Не выполняется", "3": "В работе", "4": "Ожидает контроля", "5": "Завершена"}},
        {"header": "Постановщик", "field": "owner_id", "transform": "lookup", "lookup": "users", "zero_record_labels": {"6957": "Robot", "6958": "Robot", "31777": "Robot", "48484": "Robot", "48738": "Robot", "48785": "Robot", "48826": "Robot", "48827": "Robot", "54478": "Robot"}},
        {"header": "Ответственный", "field": "responsible_id", "transform": "lookup", "lookup": "users", "zero_record_labels": {"8458": "Robot", "8459": "Robot", "8460": "Robot", "8467": "Robot", "8470": "Robot", "8471": "Robot", "8473": "Robot", "8474": "Robot", "8490": "Robot", "8495": "Robot", "8505": "Robot", "8514": "Robot", "8520": "Robot", "8521": "Robot", "8524": "Robot", "8532": "Robot", "8541": "Robot", "8548": "Robot", "8551": "Robot", "8554": "Robot", "8565": "Robot", "8572": "Robot", "8575": "Robot", "8576": "Robot", "8585": "Robot", "8586": "Robot", "8587": "Robot", "8589": "Robot", "8592": "Robot", "8593": "Robot", "8604": "Robot", "8605": "Robot", "8614": "Robot", "8618": "Robot", "8623": "Robot", "8624": "Robot", "8626": "Robot", "8630": "Robot", "8646": "Robot", "8647": "Robot", "8648": "Robot", "8650": "Robot", "8657": "Robot", "8666": "Robot", "8667": "Robot", "8676": "Robot", "8680": "Robot", "8683": "Robot", "8686": "Robot", "8694": "Robot", "8699": "Robot", "8703": "Robot", "8705": "Robot", "8706": "Robot", "8709": "Robot", "8711": "Robot", "8716": "Robot", "8717": "Robot", "8722": "Robot"}},
        {"header": "Дата создания", "field": "created_date", "transform": "datetime"},
        {"header": "Крайний срок", "field": "deadline", "transform": "datetime"},
        {"header": "Завершена", "field": "closed_date", "transform": "datetime"},
        {"header": "Возвратов на доработку", "field": "return_count", "transform": "text", "blank_if_zero": true},
        {"header": "Приоритет", "field": "priority", "transform": "enum", "values": {"0": "", "1": "Низкий", "2": "Средний", "3": "Высокий"}},
        {"header": "Просроченность", "field": "deadline", "transform": "overdue_flag", "evidence": "Presentation reconstructed from closed_date > deadline with API seconds; checked against reference cases. Not a direct API field."},
        {"header": "Проект", "field": "model_id", "transform": "project", "lookup": "projects", "strip": true}
      ]
    }
  ]
}
