        {"header": "Название", "field": "name", "transform": "text", "strip": true, "normalize_nbsp": true},
        {"header": "Категория", "field": "account_category_id", "transform": "lookup", "lookup": "categories", "strip": true},
        {"header": "Сайт", "field": "web", "transform": "text"},
        {"header": "E-mail", "field": "id", "transform": "lookup", "lookup": "emails", "empty_if_missing": true, "strip": true},
        {"header": "Город (Адрес регистрации)", "field": "billing_city", "transform": "text", "strip": true},
        {"header": "Ответственный", "field": "owner_id", "transform": "lookup", "lookup": "users", "zero_record_labels": {"9": "Robot", "224": "Robot", "230": "Robot", "280": "Robot", "548": "Robot", "564": "Robot", "604": "Robot", "623": "Robot", "646": "Robot", "6809": "Robot", "7274": "Robot", "7341": "Robot", "9346": "Robot", "9722": "Robot", "9961": "Robot", "10252": "Robot", "10273": "Robot", "10363": "Robot", "10475": "Robot", "10584": "Robot", "10703": "Robot", "10855": "Robot", "11662": "Robot", "11663": "Robot", "11665": "Robot", "11667": "Robot", "11668": "Robot", "11669": "Robot", "11672": "Robot", "11677": "Robot", "11678": "Robot", "11679": "Robot", "11680": "Robot", "11682": "Robot", "11685": "Robot", "11686": "Robot", "11689": "Robot", "11690": "Robot", "11691": "Robot", "11692": "Robot", "11693": "Robot", "11694": "Robot", "11695": "Robot", "11696": "Robot", "11697": "Robot", "11699": "Robot", "11700": "Robot", "11701": "Robot", "11704": "Robot", "11708": "Robot", "11709": "Robot", "11710": "Robot", "11711": "Robot", "11713": "Robot", "11714": "Robot", "11715": "Robot", "11718": "Robot", "11719": "Robot", "11720": "Robot", "11721": "Robot"}},
        {"header": "ID", "field": "id", "transform": "text"},
        {"header": "Дата создания", "field": "created_date", "transform": "datetime"},
        {"header": "Дата изменения", "field": "updated_date", "transform": "datetime"}
