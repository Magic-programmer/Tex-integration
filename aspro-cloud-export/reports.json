{
  "base_url": "https://gktex.aspro.cloud",
  "lookups": {
    "users": {"path": "core/user/list", "label": "name", "params": {"order_by[asc][]": "id"}, "get_path": "core/user/get/{id}", "unavailable_label": "id"},
    "categories": {"path": "crm/account_category/list", "label": "name", "params": {"order_by[asc][]": "id"}},
    "accounts": {"path": "crm/account/list", "label": "name", "params": {"order_by[asc][]": "id"}, "get_path": "crm/account/get/{id}"},
    "stages": {"path": "crm/pipeline_stage/list", "label": "name", "params": {"order_by[asc][]": "id"}},
    "sources": {"path": "crm/source/list", "label": "name", "params": {"order_by[asc][]": "id"}},
    "pipelines": {"path": "crm/pipeline/list", "label": "name", "params": {"order_by[asc][]": "id"}},
    "loss_reasons": {"path": "crm/loss_reason/list", "label": "name", "params": {"order_by[asc][]": "id"}},
    "projects": {"path": "st/projects/list", "label": "name", "params": {"order_by[asc][]": "id"}},
    "emails": {"path": "crm/emails/list", "label": "email", "key": "account_id", "many": true, "separator": ", ", "params": {"order_by[asc][]": "id"}, "unique": true, "clean_email_list": true},
    "companies": {"path": "crm/account/list", "label": "name", "params": {"order_by[asc][]": "id", "filter[type]": "1"}}
  },
  "reports": [
    {
      "name": "Контрагенты",
      "filename": "Контрагенты.csv",
      "path": "crm/account/list",
      "params": {"order_by[asc][]": "id"},
      "allow_empty": false,
      "columns": [
